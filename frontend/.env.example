# Exemple de fichier .env pour le frontend

# URL de l'API backend (pour le développement)
REACT_APP_API_URL=http://localhost:5000/api

# URL de l'API backend (pour la production)
# REACT_APP_API_URL=https://votre-domaine.com/api

# Stripe configuration (for donations)
# Get your publishable key from https://dashboard.stripe.com/test/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
