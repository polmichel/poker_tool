# Example environment file for the backend.
# Copy to .env and adjust the values.

# Flask secret key (generate a random one)
SECRET_KEY=your_secret_key_here

# JWT signing secret (generate a random one)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///poker_tool.db

# CORS origins (comma-separated; use "*" to allow all)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT access token lifetime in seconds (1 hour by default)
JWT_ACCESS_TOKEN_EXPIRES=3600

# Stripe configuration (for donations)
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Frontend URL (for Stripe checkout success/cancel redirects)
FRONTEND_URL=http://localhost:3000
